# AWS (DynamoDB). Region + creds for the study account.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito. Must be a REAL pool id — a fake value crashes the server at startup
# (the socket auth builds a verifier on boot). Study routes auth by pid, not Cognito.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Comma-separated allowed origins (Express + Socket.io both read this)
CORS_ORIGIN=http://localhost:3000

# JWT signing key
PRIVATEKEY=
