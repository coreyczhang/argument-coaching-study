option_settings:
  aws:elasticbeanstalk:command:
    Timeout: "1800"

packages:
  yum:
    python3.11: []
    python3.11-pip: []

container_commands:
  01_create_venv:
    command: "test -x /opt/point-taken-agent-venv/bin/uvicorn || python3.11 -m venv /opt/point-taken-agent-venv"
  02_install_agent_deps:
    command: "test -x /opt/point-taken-agent-venv/bin/uvicorn || /opt/point-taken-agent-venv/bin/pip install --upgrade pip -r /var/app/staging/agent/requirements.txt"
